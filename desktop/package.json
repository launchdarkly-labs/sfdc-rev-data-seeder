{
  "name": "rds-desktop",
  "version": "0.2.7",
  "description": "Rev Data Seeder Desktop — off-platform orchestrator for cross-org CPQ/sales data migration",
  "main": "out/main/index.js",
  "private": true,
  "author": "Jack Ziesing",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint src test scripts",
    "format": "prettier --write src test scripts *.md *.yml",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke-ldseed.ts",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "parity": "tsx scripts/parity-ldseed.ts",
    "golden:capture": "tsx scripts/golden-capture.ts",
    "scan:secrets": "tsx scripts/scan-secrets.ts",
    "hooks:install": "git config core.hooksPath .githooks",
    "package": "electron-vite build && electron-rebuild -f -w better-sqlite3 && electron-builder --mac --dir",
    "package:dmg": "electron-vite build && electron-rebuild -f -w better-sqlite3 && electron-builder --mac",
    "test:store": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@jsforce/jsforce-node": "^3.10.4",
    "better-sqlite3": "^12.4.1",
    "react-router-dom": "^7.18.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/rebuild": "^3.7.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.1.8"
  }
}
