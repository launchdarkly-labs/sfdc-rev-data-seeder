<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened-runtime exceptions Electron needs (A1 fix, finding #2):
       V8 requires JIT + writable-executable memory. Library validation is
       disabled because our better-sqlite3 native addon and the Electron
       framework are ad-hoc signed (no shared Team ID).
       DELIBERATELY ABSENT: com.apple.security.cs.allow-dyld-environment-variables
       — including it would re-open the DYLD_INSERT_LIBRARIES injection that the
       hardened runtime is here to block. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
